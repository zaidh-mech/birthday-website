# Copy to .env.local for local development. Everything is optional:
# without it the site uses the built-in Supabase project and passcode.
#
# NOTE: every NEXT_PUBLIC_* value is baked into the public JavaScript, so
# anyone can read it in the browser. Never put a secret key here.

# Supabase project (Dashboard -> Project Settings -> API).
# Use the "anon" / "publishable" key, NEVER the service_role key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Newer Supabase projects call it the publishable key (either one works):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Admin Studio passcode. When set, it replaces the built-in default passcode.
# It is a speed bump to keep surprises hidden, not real security.
# NEXT_PUBLIC_ADMIN_PASSWORD="choose-something-only-you-know"

# Only needed to test a GitHub Pages project-site build locally
# (the deploy workflow sets it automatically), e.g. "/birthday-website".
# PAGES_BASE_PATH=""
